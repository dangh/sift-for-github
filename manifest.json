{
  "manifest_version": 3,
  "name": "PR Files Tabs",
  "version": "0.2.0",
  "description": "Adds configurable tabs to the GitHub pull request Files changed view.",
  "permissions": ["storage"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
